# Kinesis Réadaptation — environment variables
# Copy to .env.local and fill in real values.

# --- Contact form (Resend) ---
# Get an API key at https://resend.com
RESEND_API_KEY=
# Inbox that receives contact-form submissions.
CONTACT_TO_EMAIL=contact@kinesisreadaptation.com
# Verified sender (must be a domain verified in Resend).
CONTACT_FROM_EMAIL=site@kinesisreadaptation.com

# --- Public (exposed to the browser) ---
# WhatsApp number in international format, no "+" or spaces (e.g. 221770000000).
NEXT_PUBLIC_WHATSAPP=221000000000
# Canonical site URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://kinesisreadaptation.com
