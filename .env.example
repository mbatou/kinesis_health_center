# Kinesis Réadaptation — environment variables
# Copy to .env.local and fill in real values.

# --- Contact form (Resend) ---
# Get an API key at https://resend.com
RESEND_API_KEY=
# Inbox that receives contact-form submissions.
CONTACT_TO_EMAIL=contact@kinesisreadaptation.com
# Verified sender (must be a domain verified in Resend).
CONTACT_FROM_EMAIL=site@kinesisreadaptation.com

# --- Public (exposed to the browser) ---
# WhatsApp number in international format, no "+" or spaces (e.g. 221770000000).
NEXT_PUBLIC_WHATSAPP=221000000000
# Canonical site URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://kinesisreadaptation.com

# --- Back office (/admin) ---
# Login. Username defaults to "drdiack" if unset.
ADMIN_USERNAME=drdiack
# Set a strong password in Vercel (Project → Settings → Environment Variables).
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie. Generate: `openssl rand -base64 32`.
AUTH_SECRET=

# --- Storage (provisioned on Vercel) ---
# Vercel Postgres — auto-injected when you add the database to the project
# (POSTGRES_URL, POSTGRES_PRISMA_URL, etc.). Used for editable content + submissions.
POSTGRES_URL=
# Vercel Blob — auto-injected when you add a Blob store. Used for image uploads.
BLOB_READ_WRITE_TOKEN=
